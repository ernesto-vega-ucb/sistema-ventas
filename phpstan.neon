includes:
    - ./vendor/nunomaduro/larastan/extension.neon

parameters:
    level: 4
    paths:
        - app

    ignoreErrors:
        - '#is not covariant with PHPDoc type list<string>#'
        - '#If condition is always true#'
        - '#Property .* does not accept Carbon\\Carbon\|string#'
        - '#Access to an undefined property#'
